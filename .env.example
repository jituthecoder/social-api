APP_NAME="Social W3Lead API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://social-api.w3lead.in/

FRONTEND_URL=https://social.w3lead.in
DASHBOARD_URL=https://social-dashboard.w3lead.in
CORS_ALLOWED_ORIGINS=https://social.w3lead.in,https://social-dashboard.w3lead.in,http://localhost:3000,http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=social-dashboard.w3lead.in,localhost:3000,localhost:5173,localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_autopost
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=social_w3lead_cache_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-s3-bucket-name
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_API_KEY=your-openai-or-ai-provider-key
AI_MODEL=gpt-4o-mini

# LinkedIn OAuth (https://developer.linkedin.com/)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=${APP_URL}/oauth/linkedin/callback

# YouTube / Google OAuth (https://console.cloud.google.com/)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=${APP_URL}/oauth/youtube/callback

# Facebook / Meta App (https://developers.facebook.com/)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/oauth/facebook/callback

# Instagram Business (uses Facebook/Meta App)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=${APP_URL}/oauth/instagram/callback

# X (Twitter) OAuth 2.0 with PKCE (https://developer.x.com/)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=${APP_URL}/oauth/twitter/callback

MAIL_MAILER=smtp

MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@w3lead.in"
MAIL_FROM_NAME="${APP_NAME}"

